# Copy to .dev.vars and fill in. .dev.vars is gitignored; real prod values are fine here.
# All vars below are what functions/api reads via env.*

# Turnstile official test keys: secret always passes verification locally.
# (sitekey 1x00000000000000000000AA renders a visible always-passes widget)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Paste real keys for full behavior; leave blank and email-sending steps fail gracefully.
RESEND_API_KEY=
BOOKING_OWNER_EMAIL=cole@cyberflight.studio
